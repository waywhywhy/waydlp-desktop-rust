# Maintainer: waydlp contributors
# Builds the latest development version from the main branch.
pkgname=waydlp-git
_pkgname=waydlp
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Fast, private media downloader powered by yt-dlp and FFmpeg (development version)'
arch=('x86_64' 'aarch64')
url='https://github.com/waywhywhy/waydlp-desktop-rust'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'libglvnd' 'libxkbcommon' 'hicolor-icon-theme')
optdepends=('yt-dlp: media extraction' 'ffmpeg: merging, conversion and embedding')
makedepends=('cargo' 'git')
provides=('waydlp')
conflicts=('waydlp' 'waydlp-bin')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  if git describe --tags >/dev/null 2>&1; then
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p waydlp-gui -p waydlp-cli
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/waydlp "$pkgdir/usr/bin/waydlp"
  install -Dm755 target/release/waydlp-cli "$pkgdir/usr/bin/waydlp-cli"
  install -Dm644 packaging/linux/io.github.waywhywhy.waydlp.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 packaging/linux/io.github.waywhywhy.waydlp.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  for s in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/hicolor/${s}x${s}/apps/io.github.waywhywhy.waydlp.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/io.github.waywhywhy.waydlp.png"
  done
  install -Dm644 packaging/linux/install-kind/arch "$pkgdir/usr/lib/waydlp/install-kind"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
